struct Student {
    int id;
    char name[50];
    int age;
    float average_grade;
};
int main() {
    struct Student students[5] = {
        {1, "Anna", 18, 4.8},
        {2, "Ivan", 19, 3.9},
        {3, "Maria", 18, 4.5},
        {4, "Dmitry", 20, 3.2},
        {5, "Elena", 19, 5.0}
    };

    return 0;
}
//Запрос на нахож. студента по ID
int search_id = 3;

for (int i = 0; i < 5; i++) {
    if (students[i].id == search_id) {
        printf("%s %d %.1f\n",
            students[i].name,
            students[i].age,
            students[i].average_grade);
    }
}
